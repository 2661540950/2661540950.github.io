        <description>&lt;img src="https://2661540950.github.io/p/minecraft%E6%9C%8D%E5%8A%A1%E5%99%A8/838ce4ba87f660e72953b0ca61621df2.jpeg" alt="Featured image of post Minecraft服务器" /&gt;&lt;h2 id=&#34;服务器目前正在运行香草纪元食旅纪行---vanillaerafareschron&#34;&gt;服务器目前正在运行『香草纪元:食旅纪行 - VanillaEra:FaresChron』
&lt;/h2&gt;&lt;h3 id=&#34;服务器状态&#34;&gt;服务器状态
&lt;/h3&gt;&lt;!-- 放在你想显示的地方 --&gt;
&lt;div id=&#34;mc-status&#34; style=&#34;font-family: system-ui; background:#1e1e1e; color:white; padding:16px; border-radius:12px; max-width:380px;&#34;&gt;
  &lt;div style=&#34;display:flex; align-items:center; gap:12px;&#34;&gt;
    &lt;img id=&#34;icon&#34; src=&#34;https://placehold.co/64x64?text=?&#34; width=&#34;64&#34; height=&#34;64&#34; style=&#34;border-radius:8px;&#34;&gt;
    &lt;div&gt;
      &lt;div id=&#34;motd&#34; style=&#34;font-size:1.2em; margin-bottom:4px;&#34;&gt;加载中喵...&lt;/div&gt;
      &lt;div id=&#34;players&#34;&gt;&lt;/div&gt;
      &lt;div id=&#34;version&#34;&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;
&lt;script&gt;
const server = &#34;117.72.206.53&#34;;          // ← 改成你的服务器地址
const port = 25565;                         // 非默认端口才需要填
const apiUrl = `https://api.mcsrvstat.us/2/${server}${port !== 25565 ? &#39;:&#39;+port : &#39;&#39;}`;

fetch(apiUrl)
  .then(r =&gt; r.json())
  .then(data =&gt; {
    if (!data.online) {
      document.getElementById(&#34;motd&#34;).innerHTML = &#34;服务器当前离线呜呜～&#34;;
      document.getElementById(&#34;icon&#34;).src = &#34;https://placehold.co/64x64/ff0000/ffffff?text=Offline&#34;;
      return;
    }

    document.getElementById(&#34;icon&#34;).src = data.icon || &#34;https://zh.minecraft.wiki/images/archive/20201112041753%21Grass_Block_JE7_BE6.png&#34;;
    document.getElementById(&#34;motd&#34;).innerHTML = &#34;&lt;span style=&#39;color:#98fb98; font-size:0.9em;&#39;&gt;服务器正常运行中～✨&lt;br&gt;&lt;/span&gt;&#34;;
    document.getElementById(&#34;motd&#34;).innerHTML += data.motd?.html || data.motd?.clean || &#34;欢迎来到我的小世界！&#34;;
    document.getElementById(&#34;players&#34;).innerHTML = `在线玩家：${data.players.online} / ${data.players.max}`;
    document.getElementById(&#34;version&#34;).innerHTML = `版本：${data.version}`;
  })
  .catch(() =&gt; {
    document.getElementById(&#34;motd&#34;).innerHTML = &#34;哎呀～连接API失败了呢...&#34;;
  });
&lt;/script&gt;
